<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description"
        content="Academic homepage, research, and publications.">
  <title>Your Name | Mathematics</title>

  <style>
    :root {
      --ink: #252d38;
      --muted: #637083;
      --link: #245b87;
      --line: #e1e6eb;
      --paper: #ffffff;
      --soft: #f5f7f9;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 17px;
      line-height: 1.75;
    }

    .container {
      max-width: 940px;
      margin: auto;
      padding: 0 28px;
    }

    header {
      padding: 48px 0 24px;
      border-bottom: 1px solid var(--line);
    }

    h1 {
      margin: 0;
      font-size: clamp(2rem, 5vw, 2.8rem);
      font-weight: 500;
      letter-spacing: -0.04em;
    }

    .subtitle {
      color: var(--muted);
      margin-top: 4px;
      font-family: Arial, sans-serif;
      font-size: 15px;
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 23px;
      margin-top: 22px;
      font: 14px Arial, sans-serif;
    }

    a {
      color: var(--link);
      text-decoration: none;
    }

    a:hover { text-decoration: underline; }

    main { padding: 8px 0 40px; }

    section {
      padding-top: 27px;
      scroll-margin-top: 20px;
    }

    h2 {
      margin: 0 0 12px;
      padding-bottom: 7px;
      border-bottom: 1px solid var(--line);
      font-size: 1.45rem;
      font-weight: 500;
    }

    p { margin: 8px 0 14px; }

    ul, ol { padding-left: 25px; }

    li { padding-left: 3px; margin-bottom: 10px; }

    .note {
      color: var(--muted);
      font-size: 15px;
    }

    .paper-title { font-weight: bold; }

    .button-link {
      display: inline-block;
      padding: 7px 13px;
      border: 1px solid var(--line);
      border-radius: 4px;
      font: 14px Arial, sans-serif;
    }

    footer {
      border-top: 1px solid var(--line);
      padding: 22px 0 35px;
      color: var(--muted);
      font: 13px Arial, sans-serif;
    }

    @media (max-width: 600px) {
      .container { padding: 0 19px; }
      header { padding-top: 32px; }
      body { font-size: 16px; }
    }
  </style>
</head>

<body>
  <div class="container">
    <header>
      <!-- Replace the sample name and affiliation below -->
      <h1>Your Name</h1>
      <div class="subtitle">
        Department of Mathematics · Your University
      </div>

      <nav aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#research">Research</a>
        <a href="#publications">Publications</a>
        <a href="#talks">Talks</a>
        <a href="#teaching">Teaching</a>
        <a href="#cv">CV</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main>
      <section id="about">
        <h2>About</h2>
        <p>
          Welcome to my academic homepage. I am a mathematician
          at Your University. My research interests include
          algebraic geometry, birational geometry, and related
          topics.
        </p>
        <p>
          Here you can find information about my research,
          publications, lectures, and teaching.
        </p>
        <!-- Optional: upload a photo.jpg and add an image here -->
      </section>

      <section id="research">
        <h2>Research</h2>
        <p>
          My research focuses on the following areas:
        </p>
        <ul>
          <li>Algebraic and birational geometry</li>
          <li>Geometric invariant theory</li>
          <li>Resolution of singularities</li>
        </ul>
        <p>
          <a href="https://arxiv.org/">Search papers on arXiv</a>
        </p>
      </section>

      <section id="publications">
        <h2>Selected Publications</h2>
        <ol>
          <li>
            <span class="paper-title">Title of your paper</span><br>
            Your Name and Coauthor(s). Journal, year.
            <a href="#">[Paper]</a>
            <a href="#">[arXiv]</a>
          </li>
          <li>
            <span class="paper-title">Title of another paper</span><br>
            Your Name. Journal, year.
            <a href="#">[Paper]</a>
          </li>
        </ol>
        <p class="note">
          For a complete publication list, see my CV or arXiv profile.
        </p>
      </section>

      <section id="talks">
        <h2>Talks and Lectures</h2>
        <ul>
          <li>
            <strong>Talk title</strong> — Seminar or conference,
            institution, year.
          </li>
          <li>
            <strong>Lecture series</strong> — Institution, year.
          </li>
        </ul>
      </section>

      <section id="teaching">
        <h2>Teaching</h2>
        <ul>
          <li>Course name — Fall 2026</li>
          <li>Course name — Spring 2026</li>
        </ul>
        <p class="note">
          Add course descriptions, lecture notes, and syllabi as needed.
        </p>
      </section>

      <section id="cv">
        <h2>Curriculum Vitae</h2>
        <p>
          <a class="button-link" href="cv.pdf">Download CV (PDF)</a>
        </p>
        <p class="note">
          Upload your CV as a file named cv.pdf in the repository's
          main directory.
        </p>
      </section>

      <section id="contact">
        <h2>Contact</h2>
        <p>
          Department of Mathematics<br>
          Your University<br>
          Your City, Country
        </p>
        <p>
          Email: <a href="mailto:your.email@university.edu">
            your.email@university.edu
          </a>
        </p>
        <p>
          <a href="https://scholar.google.com/">Google Scholar</a>
          &nbsp;·&nbsp;
          <a href="https://orcid.org/">ORCID</a>
          &nbsp;·&nbsp;
          <a href="https://arxiv.org/">arXiv</a>
        </p>
      </section>
    </main>

    <footer>
      © 2026 Your Name · Academic homepage
    </footer>
  </div>
</body>
</html>
